# Образ сервиса миграций: апстрим-CLI golang-migrate, собранный с драйвером SQLite.
#
# Почему не готовый образ migrate/migrate: он собирается с тегами DATABASE, в
# которых нет ни sqlite, ни sqlite3 (драйвер подключается только файлом
# internal/cli/build_sqlite.go с тегом `//go:build sqlite`), поэтому на SQLite он
# падает:
#   error: failed to open database: database driver: unknown driver sqlite (forgotten import?)
# Здесь собирается ровно тот же апстрим-CLI, только с нужным тегом: своего кода
# миграций в проекте нет, файлы миграций — обычный SQL (backend/migrations).
#
# Контекст сборки — каталог backend/:
#   docker build -f backend/Dockerfile.migrate ./backend

FROM golang:1.25-alpine AS build
ENV CGO_ENABLED=0 GOBIN=/out
RUN go install -tags sqlite github.com/golang-migrate/migrate/v4/cmd/migrate@v4.20.1

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/migrate /migrate
# Миграции монтируются в /migrations, БД лежит на общем с сервисом API volume.
VOLUME ["/data"]
ENTRYPOINT ["/migrate"]
CMD ["-path=/migrations", "-database=sqlite:///data/marketing.db", "up"]
