# Адрес прослушивания API. Значение по умолчанию — 127.0.0.1:8080: локальный
# запуск доступен только с этой машины. В docker-compose переопределяется на
# ":8080" (все интерфейсы внутри контейнера — иначе фронт не достучится до API);
# наружу при этом публикуется только 127.0.0.1:8080.
HTTP_ADDR=127.0.0.1:8080
# Файл БД (SQLite). Каталог создаётся автоматически, а схему применяет отдельный
# сервис миграций: локально `make migrate`, в compose — сервис migrate. Сервер
# миграции не применяет, а при старте проверяет, что схема готова.
# В docker-compose переопределяется на /data/marketing.db (volume).
SQLITE_PATH=data/marketing.db
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_DEFAULT=deepseek-v4-pro
MODEL_FAST=deepseek-v4-flash
LLM_MAX_RETRIES=3
RUN_TIMEOUT=10m
CRITIC_MAX_ITER=3
CRITIC_SCORE_THRESHOLD=80
MAX_TOPICS=5
COST_PER_1K_PROMPT=0.00027
COST_PER_1K_COMPLETION=0.0011
RATE_LIMIT_PER_MIN=30
LOG_LEVEL=info

# Веб-интерфейс: basic-auth (пусто = доступ без пароля, только для локалки)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# Подбор тем по поисковому спросу: Wordstat через MCP-сервер
# (см. docs/superpowers/specs/2026-10-03-wordstat-semanticist-design.md).
# Пусто WORDSTAT_MCP_URL = подбор выключен, темы генерирует стратег как раньше.
# Креды задаются парой; пароль в git не попадает — только в этот файл (.env).
WORDSTAT_MCP_URL=https://dev.coresmart.tech/wordstat-mcp/mcp
WORDSTAT_MCP_USER=admin
WORDSTAT_MCP_PASS=change-me
# Регион по умолчанию — geo ID Яндекса: 225 Россия, 1 Москва и область, 213 Москва.
WORDSTAT_REGION_DEFAULT=225
# Минимальный объём темы (показов за 30 дней) и во сколько раз пик за 12 месяцев
# Лимит обращений к Wordstat на прогон (контроль квоты и стоимости).
WORDSTAT_MAX_CALLS_PER_RUN=60

# Трасса прогона: журнал того, что делали агенты (вызовы LLM и Wordstat, решения
# отбора тем, итерации критика). off — не писать; summary — метаданные, решения и
# метрики; full — ещё и тела промптов и ответов (содержат бриф и черновики
# статей, поэтому режим отладочный).
TRACE_MODE=summary
# Срок хранения событий: старое чистится при старте сервиса.
TRACE_RETENTION_DAYS=30
# Обрезка одного payload в режиме full.
TRACE_MAX_PAYLOAD_BYTES=32768
