event: message
data: {"jsonrpc":"2.0","id":2,"result":{"ttlMs":0,"cacheScope":"public","tools":[{"description":"Динамика частотности запроса во времени (день/неделя/месяц). Фактическое окно возвращается в period/fromDate/toDate — границы по умолчанию считаются по последнему завершённому периоду. Метрика та же, что в top_requests, отличается окно.","inputSchema":{"type":"object","properties":{"phrase":{"type":"string","description":"Поисковая фраза"},"period":{"type":"string","description":"Детализация: daily, weekly, monthly (по умолчанию monthly)"},"fromDate":{"type":"string","description":"Начало периода, RFC3339 или YYYY-MM-DD. Для monthly — первый день месяца, для weekly — понедельник. По умолчанию — 12 периодов назад"},"toDate":{"type":"string","description":"Конец периода, RFC3339 или YYYY-MM-DD. Для monthly — последний день месяца, для weekly — воскресенье. По умолчанию — последний завершённый период"},"regions":{"type":["null","array"],"items":{"type":"string"},"description":"Geo ID Яндекса (до 100): '213' — Москва, '1' — Москва и область, '225' — Россия. Пусто — вся Россия"},"devices":{"type":["null","array"],"items":{"type":"string"},"description":"Устройства (до 3): all, desktop, phone, tablet. Пусто — все устройства"}},"required":["phrase"],"additionalProperties":false},"name":"dynamics","outputSchema":{"type":"object","properties":{"code":{"type":"string","description":"стабильный код ошибки: invalid_argument, quota_exceeded, upstream_unavailable, internal"},"message":{"type":"string","description":"текст ошибки от API или валидатора"},"retryable":{"type":["null","boolean"],"description":"true, если запрос имеет смысл повторить"},"phrase":{"type":"string","description":"поисковая фраза"},"period":{"type":"string","description":"фактическая детализация: PERIOD_DAILY, PERIOD_WEEKLY или PERIOD_MONTHLY"},"fromDate":{"type":"string","description":"фактическое начало периода, RFC3339"},"toDate":{"type":"string","description":"фактический конец периода, RFC3339"},"points":{"type":["null","array"],"items":{"type":"object","properties":{"date":{"type":"string","description":"дата точки, RFC3339"},"count":{"type":"integer","description":"число запросов за период"},"share":{"type":"number","description":"доля запроса от всех запросов к Яндексу"}},"required":["date","count","share"],"additionalProperties":false},"description":"точки временного ряда"},"regions":{"type":["null","array"],"items":{"type":"string"},"description":"фактический фильтр по geo ID (пусто — вся Россия)"},"devices":{"type":["null","array"],"items":{"type":"string"},"description":"фактический фильтр по устройствам (пусто — все устройства)"},"cacheHit":{"type":"boolean","description":"true — ответ взят из кэша процесса, а не запрошен у API заново"}},"required":["phrase","period","fromDate","toDate","points","regions","devices","cacheHit"],"additionalProperties":false}},{"description":"Справочник регионов (id → название) плоским списком с уровнем вложенности. Кэшируется, поэтому обычно нужен только для разового маппинга: в regions есть includeNames.","inputSchema":{"type":"object","additionalProperties":false},"name":"list_regions","outputSchema":{"type":"object","properties":{"code":{"type":"string","description":"стабильный код ошибки: invalid_argument, quota_exceeded, upstream_unavailable, internal"},"message":{"type":"string","description":"текст ошибки от API или валидатора"},"retryable":{"type":["null","boolean"],"description":"true, если запрос имеет смысл повторить"},"count":{"type":"integer","description":"сколько всего регионов в справочнике"},"regions":{"type":["null","array"],"items":{"type":"object","properties":{"id":{"type":"string","description":"ID региона"},"name":{"type":"string","description":"название региона"},"depth":{"type":"integer","description":"уровень вложенности: 0 — корень"},"parentId":{"type":"string","description":"ID родительского региона"}},"required":["id","name","depth"],"additionalProperties":false},"description":"регионы в порядке обхода дерева"},"cacheHit":{"type":"boolean","description":"true — ответ взят из кэша процесса, а не запрошен у API заново"}},"required":["count","regions","cacheHit"],"additionalProperties":false}},{"description":"Распределение спроса по регионам за последние 30 дней, отсортировано по убыванию count. affinityIndex — интерес региона относительно страны: больше 100 — выше среднего. includeNames=true добавляет названия регионов (один запрос справочника, дальше из кэша).","inputSchema":{"type":"object","properties":{"phrase":{"type":"string","description":"Поисковая фраза"},"regionMode":{"type":"string","description":"Группировка: all, cities, regions (по умолчанию all)"},"includeNames":{"type":"boolean","description":"Добавить названия регионов (join со справочником list_regions, он кэшируется)"}},"required":["phrase"],"additionalProperties":false},"name":"regions","outputSchema":{"type":"object","properties":{"code":{"type":"string","description":"стабильный код ошибки: invalid_argument, quota_exceeded, upstream_unavailable, internal"},"message":{"type":"string","description":"текст ошибки от API или валидатора"},"retryable":{"type":["null","boolean"],"description":"true, если запрос имеет смысл повторить"},"phrase":{"type":"string","description":"поисковая фраза"},"region":{"type":"string","description":"фактическая группировка: REGION_ALL, REGION_CITIES или REGION_REGIONS"},"regions":{"type":["null","array"],"items":{"type":"object","properties":{"regionId":{"type":"string","description":"ID региона"},"name":{"type":"string","description":"название региона; заполняется при includeNames = true"},"count":{"type":"integer","description":"число запросов в регионе за 30 дней"},"share":{"type":"number","description":"доля запроса от всех запросов к Яндексу в регионе"},"affinityIndex":{"type":"number","description":"индекс интереса: доля в регионе к доле по стране"}},"required":["regionId","count","share","affinityIndex"],"additionalProperties":false},"description":"распределение по регионам за 30 дней, по убыванию count"},"cacheHit":{"type":"boolean","description":"true — ответ взят из кэша процесса, а не запрошен у API заново"}},"required":["phrase","region","regions","cacheHit"],"additionalProperties":false}},{"description":"Популярные и связанные запросы по фразе за последние 30 дней. requests — подмножества totalCount, суммировать их count нельзя (сумма превышает totalCount в разы); associations — отдельные запросы, они не подмножества и их число не ограничено numPhrases. hasData=false означает, что спроса нет: это валидный ответ, а не ошибка. Ответы кэшируются в процессе: cacheHit=true — данные из кэша (TTL 24 часа).","inputSchema":{"type":"object","properties":{"phrase":{"type":"string","description":"Поисковая фраза (например, 'купить кофемашину')"},"numPhrases":{"type":"integer","description":"Сколько фраз вернуть в requests (1..2000), по умолчанию 20; на associations не влияет — они приходят своим числом"},"regions":{"type":["null","array"],"items":{"type":"string"},"description":"Geo ID Яндекса (до 100): '213' — Москва, '1' — Москва и область, '225' — Россия. Пусто — вся Россия"},"devices":{"type":["null","array"],"items":{"type":"string"},"description":"Устройства (до 3): all, desktop, phone, tablet. Пусто — все устройства"}},"required":["phrase"],"additionalProperties":false},"name":"top_requests","outputSchema":{"type":"object","properties":{"code":{"type":"string","description":"стабильный код ошибки: invalid_argument, quota_exceeded, upstream_unavailable, internal"},"message":{"type":"string","description":"текст ошибки от API или валидатора"},"retryable":{"type":["null","boolean"],"description":"true, если запрос имеет смысл повторить"},"phrase":{"type":"string","description":"поисковая фраза"},"hasData":{"type":"boolean","description":"false — Wordstat не знает такой фразы, спроса нет; это не ошибка, а валидный ответ"},"totalCount":{"type":"integer","description":"общее число запросов, содержащих все слова фразы, за 30 дней"},"requests":{"type":["null","array"],"items":{"type":"object","properties":{"phrase":{"type":"string","description":"формулировка запроса"},"count":{"type":"integer","description":"число запросов за последние 30 дней"}},"required":["phrase","count"],"additionalProperties":false},"description":"популярные запросы по убыванию частотности; это подмножества totalCount, суммировать их нельзя"},"associations":{"type":["null","array"],"items":{"type":"object","properties":{"phrase":{"type":"string","description":"формулировка запроса"},"count":{"type":"integer","description":"число запросов за последние 30 дней"}},"required":["phrase","count"],"additionalProperties":false},"description":"похожие запросы; не подмножества totalCount"},"regions":{"type":["null","array"],"items":{"type":"string"},"description":"фактический фильтр по geo ID (пусто — вся Россия)"},"devices":{"type":["null","array"],"items":{"type":"string"},"description":"фактический фильтр по устройствам (пусто — все устройства)"},"cacheHit":{"type":"boolean","description":"true — ответ взят из кэша процесса, а не запрошен у API заново"}},"required":["phrase","hasData","totalCount","requests","associations","regions","devices","cacheHit"],"additionalProperties":false}}]}}

